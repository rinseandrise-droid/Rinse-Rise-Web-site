# Public site URL (used for Open Graph, sitemap and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — required for accounts, addresses and orders.
# Create a project, run supabase/migrations/0001_init.sql, then paste keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to create orders after prices are recalculated from the rate card.
# Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
